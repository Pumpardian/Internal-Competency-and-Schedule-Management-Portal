# Базовый URL REST API бэкенда.
# В docker-окружении фронт ходит через nginx, поэтому относительный путь /api.
# При прямом локальном запуске укажите полный адрес, например
# http://127.0.0.1:8000/api (127.0.0.1, а не localhost: на Windows localhost
# часто резолвится в IPv6 ::1, куда uvicorn по умолчанию не слушает).
VITE_API_BASE=/api
