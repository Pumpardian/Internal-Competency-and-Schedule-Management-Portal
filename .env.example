POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=postgres

# Подпись JWT (используется бэкендом в контейнере). Значения без кавычек —
# docker env_file передаёт их буквально (с кавычками алгоритм сломает подпись).
# AUTH_SECRET — задайте свой случайный секрет в реальном окружении.
AUTH_SECRET=0123456789012345678901234567890123456789012345678901234567890123
AUTH_ALGORITHM=HS256
