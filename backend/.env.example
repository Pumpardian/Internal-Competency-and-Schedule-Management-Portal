# Подключение к PostgreSQL (используется backend и Alembic).
DATABASE_URL=postgresql+psycopg2://portal:portal@localhost:5433/portal

# Источники, которым разрешён CORS (через запятую). Необязательно —
# по умолчанию разрешён dev-сервер Vite на localhost:5173.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
